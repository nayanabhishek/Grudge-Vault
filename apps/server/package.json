{
  "name": "@grudge-vault/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "corepack pnpm run build && node --test test/server.test.mjs test/sqlite-transaction.test.mjs test/sqlite-startup.test.mjs"
  },
  "dependencies": {
    "@grudge-vault/game-engine": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "better-sqlite3": "^11.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "^20.17.10",
    "@types/better-sqlite3": "7.6.12",
    "typescript": "~5.7.3"
  }
}
