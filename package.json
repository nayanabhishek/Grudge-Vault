{
  "name": "grudge-vault",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=18", "pnpm": ">=9" },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @grudge-vault/web --filter @grudge-vault/server dev",
